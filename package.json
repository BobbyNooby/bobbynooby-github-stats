{
  "name": "bobbynooby-github-stats",
  "version": "0.2.0",
  "description": "One service, your whole GitHub-stats card: daily snapshots into SQLite, JSON API, and an animated SVG profile card. Only GITHUB_USERNAME required.",
  "type": "module",
  "scripts": {
    "dev": "bun --watch run src/index.ts",
    "start": "bun run src/index.ts",
    "ingest": "bun run src/index.ts --ingest-only",
    "mock": "bun run scripts/mock-github.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.3.0",
    "@elysiajs/swagger": "^1.3.1",
    "elysia": "^1.3.0"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "typescript": "^5.6.0"
  }
}
