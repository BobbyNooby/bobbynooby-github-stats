# ── Required ──────────────────────────────────────────────────────
GITHUB_USERNAME=your-username

# ── GitHub access (optional) ──────────────────────────────────────
# Any PAT, no scopes needed: 1-request GraphQL snapshots, official
# language colors, rate-limit headroom.
# GITHUB_TOKEN=
# Include private repos (needs a token WITH private access).
# WARNING: their stats become publicly visible in the SVG.
# INCLUDE_PRIVATE=false

# ── Branding (optional) ───────────────────────────────────────────
# HANDLE=                       # ">handle" in the title; defaults to GITHUB_USERNAME
# LOGO=auto                     # auto = assets/logo.svg if present, else built-in | dot | none
# LOGO_SIZE=27                  # px
# LOGO_Y=23                     # px from top edge
# LOGO_INSET=40                 # px from right edge

# ── Card layout & motion (optional) ───────────────────────────────
# DEFAULT_THEME=auto            # auto | light | dark
# SHOW_BAR=true
# SHOW_GRAPHS=auto              # auto = appear once >=14 days of history exists | true | false
# SHOW_ALL_LANGUAGES=true
# ANIMATION_PRESET=together     # cascade (~6s) | snappy (~2.5s) | together (~1s)
# ANIMATION_SPEED=1             # 0.5 = twice as fast
# Per-section overrides in seconds — sections: totals bar tiles graphs allLanguages logo
# ANIMATION_BAR_DELAY=0.2
# ANIMATION_GRAPHS_GAP=0.5

# ── Service (optional) ────────────────────────────────────────────
# PORT=3000
# DB_PATH=/data/stats.db        # mounted volume — history accumulates across restarts
# INTERVAL_HOURS=24             # the snapshot + git-history sync run automatically on
#                               # boot, then again whenever the last snapshot is older
#                               # than this many hours (checked hourly)
# CORS_ORIGIN=*
# API_SECRET=                   # require Bearer key on /api/* JSON routes
# REFRESH_SECRET=               # enables POST /api/refresh

# ── Development (optional) ────────────────────────────────────────
# DEMO=false                    # stub data, zero network
# GITHUB_API_BASE=              # GitHub API overrides for testing
# GITHUB_API_URL=
